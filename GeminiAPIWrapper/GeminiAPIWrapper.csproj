<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>GeminiAPIWrapper</Title>
    <Authors>Osg-Junue</Authors>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>Lightweight, AOT-friendly .NET client for the Gemini API with Microsoft.Extensions.AI (IChatClient) support, built to run behind API gateways and proxies (Azure API Management, Cloudflare AI Gateway, custom reverse proxies). Configurable API key header, key prefix, and extra headers.</Description>
    <PackageProjectUrl>https://github.com/Osg-Junue/GeminiAPIWrapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Osg-Junue/GeminiAPIWrapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gemini;google;generative-ai;llm;ai;ichatclient;microsoft-extensions-ai;api-gateway;proxy;apim;cloudflare;aot</PackageTags>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
    <Version>2.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>See https://github.com/Osg-Junue/GeminiAPIWrapper/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeminiAPIWrapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
