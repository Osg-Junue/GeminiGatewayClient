<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>GeminiGatewayClient</Title>
    <Authors>Osg-Junue</Authors>
    <!-- Only produce the .nupkg for Release builds instead of on every (Debug) build. -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Description>Lightweight, AOT-friendly .NET client for the Gemini API with Microsoft.Extensions.AI (IChatClient and IEmbeddingGenerator) support, Google Search &amp; URL Context grounding, and embeddings, built to run behind API gateways and proxies (Azure API Management, Cloudflare AI Gateway, custom reverse proxies). Configurable API key header, key prefix, and extra headers.</Description>
    <PackageProjectUrl>https://github.com/Osg-Junue/GeminiGatewayClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Osg-Junue/GeminiGatewayClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gemini;google;generative-ai;llm;ai;ichatclient;iembeddinggenerator;embeddings;grounding;microsoft-extensions-ai;api-gateway;proxy;apim;cloudflare;aot</PackageTags>
    <Version>2.1.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>See https://github.com/Osg-Junue/GeminiGatewayClient/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeminiGatewayClient.Tests" />
    <InternalsVisibleTo Include="GeminiGatewayClient.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
